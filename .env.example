DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=7d

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comma-separated deployed/preview frontend origins. Local Vite ports 5173 and
# 5174 are allowed automatically. FRONTEND_URL remains supported for one origin.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# Template extraction sends compact logical document content to Gemini first.
GEMINI_API_KEY=
GEMINI_TEMPLATE_MODEL=gemini-3.6-flash
GEMINI_TEMPLATE_THINKING_LEVEL=medium
GEMINI_TEMPLATE_TIMEOUT_MS=90000
GEMINI_TEMPLATE_MAX_OUTPUT_TOKENS=8192

OPENROUTER_API_KEY=
OPENROUTER_TEMPLATE_MODEL=google/gemini-3.5-flash
OPENROUTER_TEMPLATE_REASONING_EFFORT=medium
OPENROUTER_TEMPLATE_TIMEOUT_MS=90000
OPENROUTER_TEMPLATE_MAX_OUTPUT_TOKENS=8192

TEMPLATE_AI_PRIMARY=gemini
TEMPLATE_AI_FALLBACK=openrouter

# Signs short-lived, backend-only client registration draft tokens.
CLIENT_REGISTRATION_TOKEN_SECRET=
CLIENT_REGISTRATION_TOKEN_TTL=60m

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=7d

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comma-separated deployed/preview frontend origins. Local Vite ports 5173 and
# 5174 are allowed automatically. FRONTEND_URL remains supported for one origin.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# Template extraction uses DeepSeek through OpenRouter only.
OPENROUTER_API_KEY=
OPENROUTER_TEMPLATE_MODEL=deepseek/deepseek-chat:free
OPENROUTER_TEMPLATE_FALLBACK_MODEL=deepseek/deepseek-chat
OPENROUTER_TEMPLATE_REASONING_EFFORT=low
OPENROUTER_TEMPLATE_TIMEOUT_MS=45000
OPENROUTER_TEMPLATE_MAX_OUTPUT_TOKENS=6000
TESSERACT_LANG_PATH=

# Signs short-lived, backend-only client registration draft tokens.
CLIENT_REGISTRATION_TOKEN_SECRET=
CLIENT_REGISTRATION_TOKEN_TTL=60m
